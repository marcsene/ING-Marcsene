.app-header {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  background: #ffffff;
  border-bottom: 1px solid #e5e7eb;
}
.app-brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.app-brand-logo {
  display: block;
  width: 190px;
  height: auto;
  max-height: 58px;
  object-fit: contain;
}
.app-brand {
  display: flex;
  align-items: baseline;
  gap: 12px;
}

.app-brand strong {
  font-size: 1.25rem;
  color: #172033;
}

.app-brand span {
  color: #6b7280;
  font-size: 0.9rem;
}

.app-user {
  color: #4b5563;
  font-size: 0.9rem;
}
.app-sidebar {
  width: 230px;
  min-height: calc(100vh - 72px);
  padding: 24px 16px;
  background: #172033;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.sidebar-link {
  display: block;
  padding: 11px 14px;
  border-radius: 8px;
  color: #dbe2ee;
  font-size: 0.95rem;
  transition: background 0.2s ease;
}

.sidebar-link:hover {
  background: #26334d;
  color: #ffffff;
}
.app-body {
  display: flex;
  min-height: calc(100vh - 72px);
}

.app-content {
  flex: 1;
  padding: 32px;
  overflow-x: auto;
}
.dashboard {
  max-width: 1200px;
}

.dashboard-heading {
  margin-bottom: 28px;
}

.dashboard-heading h1 {
  margin-bottom: 6px;
  font-size: 1.8rem;
}

.dashboard-heading p {
  color: #6b7280;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.stat-card span {
  color: #6b7280;
  font-size: 0.9rem;
}

.stat-card strong {
  color: #172033;
  font-size: 1.7rem;
}
.products-page {
  max-width: 1200px;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.page-heading h1 {
  margin-bottom: 6px;
  font-size: 1.8rem;
}

.page-heading p {
  color: #6b7280;
}

.page-heading button {
  padding: 10px 16px;
  border: 0;
  border-radius: 8px;
  background: #172033;
  color: #ffffff;
  cursor: pointer;
  transition: background 0.2s ease;
}

.page-heading button:hover {
  background: #26334d;
}

.products-table {
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.products-table-header,
.products-table-row {
  display: grid;
  grid-template-columns: 2fr 1.5fr 1fr 1fr 1fr 1.4fr;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
}

.products-table-header {
  background: #f8fafc;
  border-bottom: 1px solid #e5e7eb;
  color: #6b7280;
  font-size: 0.85rem;
  font-weight: 600;
}

.products-table-row {
  border-bottom: 1px solid #f0f2f5;
}

.products-table-row:last-child {
  border-bottom: 0;
}

.products-table-row span {
  color: #172033;
  font-size: 0.95rem;
}
.product-status {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
}

.product-status-active {
  background: #e8f7ee;
  color: #187a42;
}

.product-status-inactive {
  background: #fceaea;
  color: #a33a3a;
}
.product-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.product-actions button {
  padding: 6px 10px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  background: #ffffff;
  color: #172033;
  font-size: 0.85rem;
  cursor: pointer;
}

.product-actions button:hover {
  background: #f3f4f6;
}
/* Product form */

.product-form {
  max-width: 760px;
  padding: 28px;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
}

.product-form-header {
  margin-bottom: 28px;
}

.product-form-header h2 {
  margin-bottom: 6px;
  font-size: 1.5rem;
  color: #172033;
}

.product-form-header p {
  color: #6b7280;
}

.product-form form {
  display: grid;
  gap: 20px;
}

.form-group {
  display: grid;
  gap: 7px;
}

.form-group label {
  color: #172033;
  font-size: 0.9rem;
  font-weight: 600;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 11px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: #ffffff;
  color: #172033;
  outline: none;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #172033;
  box-shadow: 0 0 0 3px rgba(23, 32, 51, 0.08);
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
  padding-top: 20px;
  border-top: 1px solid #e5e7eb;
}

.form-actions button {
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}

.form-actions button[type="button"] {
  border: 1px solid #d1d5db;
  background: #ffffff;
  color: #172033;
}

.form-actions button[type="button"]:hover {
  background: #f3f4f6;
}

.form-actions button[type="submit"] {
  border: 0;
  background: #172033;
  color: #ffffff;
}

.form-actions button[type="submit"]:hover {
  background: #26334d;
}

@media (max-width: 640px) {
  .product-form {
    padding: 20px;
  }

  .form-actions {
    flex-direction: column-reverse;
  }

  .form-actions button {
    width: 100%;
  }
}
/* =========================
   SIDEBAR
   ========================= */

.app-sidebar {
  background: #172033;
  padding: 24px 16px;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sidebar-link {
  width: 100%;
  border: 0;
  border-radius: 10px;
  padding: 13px 16px;
  background: transparent;
  color: #d9e1f2;
  text-align: left;
  font-weight: 500;
  cursor: pointer;
  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.sidebar-link:hover {
  background: #24304a;
  color: #ffffff;
}

.sidebar-link.active {
  background: #ffffff;
  color: #172033;
  font-weight: 700;
}

/* =========================
   CATEGORÍAS
   ========================= */

.categories-page {
  max-width: 1100px;
  margin: 0 auto;
}

.categories-list {
  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(280px, 1fr)
  );
  gap: 20px;
  margin-top: 28px;
}

.category-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.06);
}

.category-card h2 {
  margin-bottom: 8px;
  font-size: 20px;
  color: #172033;
}

.category-card span {
  font-size: 14px;
  color: #16834b;
  font-weight: 600;
}

.category-card > div:last-child {
  display: flex;
  gap: 8px;
}

.category-card button {
  border: 0;
  border-radius: 8px;
  padding: 8px 12px;
  cursor: pointer;
  font-weight: 500;
}

.category-card button:first-child {
  background: #eef2f7;
  color: #172033;
}

.category-card button:last-child {
  background: #fff0f0;
  color: #b42318;
}

.category-card button:hover {
  opacity: 0.8;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 700px) {
  .category-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .category-card > div:last-child {
    width: 100%;
  }

  .category-card button {
    flex: 1;
  }
}
/* =========================
   MÓDULOS
   ========================= */

.module-empty-state {
  margin-top: 28px;
  padding: 40px;
  background: #ffffff;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.06);
}

.module-empty-state h2 {
  margin-bottom: 10px;
  color: #172033;
  font-size: 20px;
}

.module-empty-state p {
  color: #667085;
}

/* =========================
   INVENTARIO
   ========================= */

.inventory-page {
  max-width: 1100px;
  margin: 0 auto;
}

.inventory-list {
  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(280px, 1fr)
  );
  gap: 20px;
  margin-top: 28px;
}

.inventory-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.06);
}

.inventory-card h2 {
  margin-bottom: 8px;
  color: #172033;
  font-size: 18px;
}

.inventory-card span {
  color: #667085;
  font-size: 14px;
}

.inventory-card > div:last-child {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.inventory-card strong {
  color: #172033;
  font-size: 28px;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 700px) {
  .inventory-card {
    align-items: flex-start;
    flex-direction: column;
  }

  .inventory-card > div:last-child {
    align-items: flex-start;
  }

  .module-empty-state {
    padding: 24px;
  }
}
/* =========================
   CLIENTES
   ========================= */

.customers-page {
  max-width: 1100px;
  margin: 0 auto;
}

.customers-list {
  display: grid;
  grid-template-columns: repeat(
    auto-fit,
    minmax(320px, 1fr)
  );
  gap: 20px;
  margin-top: 28px;
}

.customer-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  padding: 24px;
  background: #ffffff;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.06);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.customer-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(23, 32, 51, 0.09);
}

.customer-card h2 {
  margin-bottom: 12px;
  color: #172033;
  font-size: 19px;
}

.customer-card p {
  margin-bottom: 6px;
  color: #667085;
  font-size: 14px;
}

.customer-card span {
  display: inline-flex;
  margin-top: 8px;
  padding: 5px 10px;
  border-radius: 999px;
  background: #e8f7ee;
  color: #187a42;
  font-size: 12px;
  font-weight: 600;
}

.customer-card > div:last-child {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.customer-card button {
  border: 0;
  border-radius: 8px;
  padding: 8px 12px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition:
    background 0.2s ease,
    opacity 0.2s ease;
}

.customer-card button:first-child {
  background: #eef2f7;
  color: #172033;
}

.customer-card button:first-child:hover {
  background: #e2e7ef;
}

.customer-card button:last-child {
  background: #fff0f0;
  color: #b42318;
}

.customer-card button:last-child:hover {
  background: #fde2e2;
}

@media (max-width: 700px) {
  .customers-list {
    grid-template-columns: 1fr;
  }

  .customer-card {
    flex-direction: column;
    gap: 18px;
  }

  .customer-card > div:last-child {
    width: 100%;
  }

  .customer-card button {
    flex: 1;
  }
}
/* =========================
   DASHBOARD STATS
   ========================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  margin-top: 28px;
}

.stat-card {
  min-height: 170px;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #e4e8f0;
  border-radius: 16px;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.05);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(23, 32, 51, 0.09);
}

.stat-card-top {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stat-card-top span {
  color: #667085;
  font-size: 14px;
  font-weight: 600;
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 800;
}

.stat-card strong {
  display: block;
  margin-top: 22px;
  color: #172033;
  font-size: 32px;
  line-height: 1;
}

.stat-card p {
  margin-top: 12px;
  color: #98a2b3;
  font-size: 13px;
}

.stat-card-primary .stat-icon {
  background: #eef2ff;
  color: #4338ca;
}

.stat-card-info .stat-icon {
  background: #eaf4ff;
  color: #1769aa;
}

.stat-card-warning .stat-icon {
  background: #fff4df;
  color: #b54708;
}

.stat-card-success .stat-icon {
  background: #e8f7ee;
  color: #187a42;
}

@media (max-width: 1000px) {
  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .stat-card {
    min-height: 150px;
  }
}
/* =========================
   DASHBOARD ALERTS
   ========================= */

.dashboard-section {
  margin-top: 28px;
  padding: 24px;
  background: #ffffff;
  border: 1px solid #e4e8f0;
  border-radius: 16px;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.05);
}

.dashboard-section-heading {
  margin-bottom: 20px;
}

.dashboard-section-heading h2 {
  color: #172033;
  font-size: 20px;
}

.dashboard-section-heading p {
  margin-top: 6px;
  color: #667085;
  font-size: 14px;
}

.dashboard-empty {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  background: #f0faf4;
  border: 1px solid #d6f0df;
  border-radius: 12px;
}

.dashboard-empty > span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #dff5e7;
  color: #187a42;
  font-weight: 800;
}

.dashboard-empty strong {
  color: #187a42;
  font-size: 14px;
}

.dashboard-empty p {
  margin-top: 4px;
  color: #667085;
  font-size: 13px;
}

.low-stock-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.low-stock-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 16px;
  background: #fffaf0;
  border: 1px solid #f8e4b8;
  border-radius: 12px;
}

.low-stock-item > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.low-stock-item > div:first-child strong {
  color: #172033;
  font-size: 15px;
}

.low-stock-item > div:first-child span {
  color: #667085;
  font-size: 13px;
}

.low-stock-value {
  display: flex;
  align-items: baseline;
  gap: 5px;
  color: #b54708;
}

.low-stock-value strong {
  font-size: 22px;
}

.low-stock-value span {
  font-size: 12px;
}

@media (max-width: 600px) {
  .dashboard-section {
    padding: 18px;
  }

  .low-stock-item {
    align-items: flex-start;
    flex-direction: column;
  }
}
/* ========================================
   SALES
======================================== */

.sales-page {
  width: 100%;
}

.sales-list {
  display: grid;
  gap: 18px;
  margin-top: 28px;
  max-width: 1000px;
}

.sales-card {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 22px 24px;
  background: #ffffff;
  border: 1px solid #e5e9f2;
  border-radius: 16px;
  box-shadow: 0 6px 18px rgba(20, 32, 51, 0.05);
}

.sales-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid #edf0f5;
}

.sales-card-header > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.sales-card-header strong:first-child {
  font-size: 18px;
  color: #172033;
}

.sales-card-header span {
  font-size: 14px;
  color: #687386;
}

.sales-total {
  font-size: 21px;
  color: #172033;
  white-space: nowrap;
}

.sales-card-items {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sales-item {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 20px;
  padding: 12px 14px;
  background: #f7f8fb;
  border-radius: 10px;
}

.sales-item span:first-child {
  font-weight: 600;
  color: #172033;
}

.sales-item span:nth-child(2) {
  color: #687386;
  font-size: 14px;
}

.sales-item strong {
  min-width: 90px;
  text-align: right;
  color: #172033;
}

.sales-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 2px;
  color: #7a8495;
  font-size: 13px;
}

.sale-status {
  padding: 6px 10px;
  border-radius: 999px;
  background: #e9f8ef;
  color: #198754;
  font-weight: 600;
}

@media (max-width: 700px) {
  .sales-card {
    padding: 18px;
  }

  .sales-card-header {
    align-items: flex-start;
  }

  .sales-item {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .sales-item strong {
    min-width: auto;
    text-align: left;
  }

  .sales-card-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
/* ========================================
   NEW SALE FORM
======================================== */

.new-sale-form {
  width: 100%;
  max-width: 900px;
  padding: 28px;
  background: #ffffff;
  border: 1px solid #e5e9f2;
  border-radius: 18px;
  box-shadow: 0 8px 24px rgba(20, 32, 51, 0.06);
}

.new-sale-heading {
  margin-bottom: 28px;
}

.new-sale-heading h2 {
  font-size: 28px;
  color: #172033;
  margin-bottom: 6px;
}

.new-sale-heading p {
  color: #687386;
  font-size: 15px;
}

.new-sale-fields {
  display: grid;
  grid-template-columns: 1fr 1fr 180px;
  gap: 18px;
}

.new-sale-fields label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #172033;
  font-size: 14px;
  font-weight: 600;
}

.new-sale-fields select,
.new-sale-fields input {
  width: 100%;
  height: 46px;
  padding: 0 12px;
  border: 1px solid #d9deea;
  border-radius: 10px;
  background: #ffffff;
  color: #172033;
  outline: none;
}

.new-sale-fields select:focus,
.new-sale-fields input:focus {
  border-color: #172033;
  box-shadow: 0 0 0 3px rgba(23, 32, 51, 0.08);
}

.new-sale-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 28px;
  padding: 18px;
  background: #f7f8fb;
  border-radius: 12px;
}

.new-sale-summary div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.new-sale-summary span {
  color: #687386;
  font-size: 13px;
}

.new-sale-summary strong {
  color: #172033;
  font-size: 18px;
}

.new-sale-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid #edf0f5;
}

.new-sale-actions button {
  min-height: 44px;
  padding: 0 20px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
}

.new-sale-actions button:first-child {
  background: #eef1f6;
  color: #172033;
}

.new-sale-actions button:last-child {
  background: #172033;
  color: #ffffff;
}

.new-sale-actions button:last-child:disabled {
  background: #c8ced9;
  cursor: not-allowed;
}

@media (max-width: 800px) {
  .new-sale-fields {
    grid-template-columns: 1fr;
  }

  .new-sale-summary {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .new-sale-form {
    padding: 20px;
  }

  .new-sale-heading h2 {
    font-size: 24px;
  }

  .new-sale-actions {
    flex-direction: column-reverse;
  }

  .new-sale-actions button {
    width: 100%;
  }
}
.new-sale-error {
  margin-bottom: 20px;
  padding: 12px 14px;
  border: 1px solid #f1b8b8;
  border-radius: 10px;
  background: #fff1f1;
  color: #b42318;
  font-size: 14px;
  font-weight: 600;
}
.dashboard-group {
  margin-bottom: 32px;
}

.dashboard-group-heading {
  margin-bottom: 16px;
}

.dashboard-group-heading h2 {
  margin-bottom: 4px;
  color: #172033;
  font-size: 20px;
}

.dashboard-group-heading p {
  color: #718096;
  font-size: 14px;
}

.recent-sales-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.recent-sale-item {
  display: grid;
  grid-template-columns: 160px 1fr 180px;
  align-items: center;
  gap: 20px;
  padding: 18px 20px;
  border: 1px solid #e6eaf0;
  border-radius: 14px;
  background: #ffffff;
}

.recent-sale-main {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.recent-sale-main strong {
  color: #172033;
  font-size: 15px;
}

.recent-sale-main span {
  color: #718096;
  font-size: 14px;
}

.recent-sale-products {
  color: #4a5568;
  font-size: 14px;
}

.recent-sale-total {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5px;
}

.recent-sale-total strong {
  color: #172033;
  font-size: 17px;
}

.recent-sale-total span {
  color: #718096;
  font-size: 12px;
}

@media (max-width: 900px) {
  .recent-sale-item {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .recent-sale-total {
    align-items: flex-start;
  }
}
/* ========================================
   RESPONSIVE GENERAL - MOBILE
======================================== */

@media (max-width: 768px) {
  .app-header {
    min-height: 72px;
    padding: 14px 18px;
    gap: 12px;
  }

  .app-brand {
    min-width: 0;
  }

  .app-brand strong {
    font-size: 20px;
  }

  .app-brand span {
    font-size: 13px;
  }

  .app-user {
    font-size: 13px;
    white-space: nowrap;
  }

  .app-body {
    display: block;
  }

  .app-sidebar {
    width: 100%;
    padding: 10px 12px;
  }

  .sidebar-nav {
    flex-direction: row;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .sidebar-link {
    width: auto;
    min-width: max-content;
    padding: 10px 14px;
    font-size: 14px;
    white-space: nowrap;
  }

  .app-content {
    width: 100%;
    padding: 20px 14px;
    overflow-x: hidden;
  }

  .customers-page,
  .categories-page,
  .inventory-page,
  .sales-page {
    width: 100%;
    max-width: 100%;
  }

  .customer-card,
  .category-card,
  .inventory-card,
  .sales-card,
  .new-sale-form,
  .module-empty-state {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .app-header {
    align-items: flex-start;
  }

  .app-brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .app-user {
    margin-left: auto;
  }

  .app-content {
    padding: 16px 10px;
  }

  .customer-card,
  .category-card,
  .inventory-card,
  .sales-card,
  .new-sale-form {
    padding: 16px;
    border-radius: 12px;
  }
}
/* ================================
   RESPONSIVE MOBILE
   ================================ */

@media (max-width: 768px) {
  .app-body {
    display: block;
  }

  .app-sidebar {
    width: 100%;
    height: auto;
    min-height: auto;
    overflow: hidden;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: row;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 10px 12px;
    gap: 8px;
    scrollbar-width: none;
  }

  .sidebar-nav::-webkit-scrollbar {
    display: none;
  }

  .sidebar-link {
    flex: 0 0 auto;
    white-space: nowrap;
    width: auto;
    min-width: max-content;
    padding: 12px 18px;
  }

  .app-content {
    width: 100%;
    min-width: 0;
    padding: 20px 16px;
  }

  .app-header {
    min-height: 90px;
    padding: 18px 20px;
  }

  .app-brand {
    gap: 4px;
  }

  .app-brand span {
    display: block;
  }

  .app-user {
    white-space: nowrap;
  }
}
/* ========================================
   REPORTS
======================================== */

.reports-page {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

.reports-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
}

.report-card {
  display: flex;
  align-items: center;
  gap: 18px;
  width: 100%;
  min-height: 150px;
  padding: 24px;
  border: 1px solid #e4e8f0;
  border-radius: 16px;
  background: #ffffff;
  text-align: left;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.report-card:hover {
  transform: translateY(-2px);
  border-color: #cfd6e4;
  box-shadow: 0 8px 24px rgba(23, 32, 51, 0.08);
}

.report-card-icon,
.report-summary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58px;
  height: 58px;
  border-radius: 14px;
  background: #f1f4f9;
  font-size: 28px;
}

.report-card-content {
  flex: 1;
}

.report-card-content h2,
.report-summary-card h2 {
  margin-bottom: 6px;
  font-size: 19px;
  color: #172033;
}

.report-card-content p,
.report-summary-card p {
  color: #697386;
  font-size: 14px;
  line-height: 1.5;
}

.report-card-arrow {
  font-size: 24px;
  color: #7a8496;
}

.report-summary-card {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 20px;
  padding: 24px;
  border: 1px solid #e4e8f0;
  border-radius: 16px;
  background: #ffffff;
}
@media (max-width: 768px) {
  .reports-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .report-card {
    min-height: 125px;
    padding: 18px;
  }

  .report-summary-card {
    padding: 18px;
  }
}

@media (max-width: 480px) {
  .report-card {
    gap: 14px;
  }

  .report-card-icon,
  .report-summary-icon {
    width: 48px;
    height: 48px;
    font-size: 23px;
  }

  .report-card-content h2,
  .report-summary-card h2 {
    font-size: 17px;
  }

  .report-card-content p,
  .report-summary-card p {
    font-size: 13px;
  }

  .report-card-arrow {
    font-size: 20px;
  }
}
/* ========================================
   REPORT SUMMARY
======================================== */

.report-summary-section {
  margin-top: 24px;
}

.report-summary-heading {
  margin-bottom: 18px;
}

.report-summary-heading h2 {
  margin-bottom: 6px;
  font-size: 24px;
  color: #172033;
}

.report-summary-heading p {
  color: #697386;
  font-size: 14px;
}

.report-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.report-summary-stat {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 110px;
  padding: 18px;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.04);
}

.report-summary-stat > span {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #f1f4f9;
  font-size: 23px;
}

.report-summary-stat div {
  min-width: 0;
}

.report-summary-stat small {
  display: block;
  margin-bottom: 5px;
  color: #697386;
  font-size: 13px;
}

.report-summary-stat strong {
  display: block;
  color: #172033;
  font-size: 21px;
  font-weight: 700;
  overflow-wrap: anywhere;
}
@media (max-width: 1000px) {
  .report-summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .report-summary-grid {
    grid-template-columns: 1fr;
  }

  .report-summary-stat {
    min-height: 95px;
  }

  .report-summary-heading h2 {
    font-size: 21px;
  }
}
/* ========================================
   SALES REPORT
======================================== */

.sales-report {
  margin-top: 32px;
}

.report-section-heading {
  margin-bottom: 18px;
}

.report-section-heading h2 {
  margin-bottom: 6px;
  font-size: 24px;
  color: #172033;
}

.report-section-heading p {
  color: #697386;
  font-size: 14px;
}

.sales-report-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.sales-report-stat {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 110px;
  padding: 18px;
  border: 1px solid #e4e8f0;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.04);
}

.sales-report-stat > span {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #f1f4f9;
  font-size: 23px;
}

.sales-report-stat small {
  display: block;
  margin-bottom: 5px;
  color: #697386;
  font-size: 13px;
}

.sales-report-stat strong {
  display: block;
  color: #172033;
  font-size: 21px;
}

.sales-report-table-wrapper {
  overflow: hidden;
  border: 1px solid #e4e8f0;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 4px 14px rgba(23, 32, 51, 0.04);
}

.sales-report-table-heading {
  padding: 20px 22px;
  border-bottom: 1px solid #e8ebf1;
}

.sales-report-table-heading h3 {
  margin-bottom: 5px;
  color: #172033;
  font-size: 19px;
}

.sales-report-table-heading p {
  color: #697386;
  font-size: 14px;
}

.sales-report-table {
  width: 100%;
  overflow-x: auto;
}

.sales-report-row {
  display: grid;
  grid-template-columns:
    1fr
    1.4fr
    1.3fr
    1fr
    1fr;
  align-items: center;
  min-width: 720px;
  padding: 16px 22px;
  border-bottom: 1px solid #edf0f5;
  gap: 16px;
}

.sales-report-row:last-child {
  border-bottom: none;
}

.sales-report-row > span,
.sales-report-row > strong {
  font-size: 14px;
  color: #4f5b70;
}

.sales-report-row > strong {
  color: #172033;
  text-align: right;
}

.sales-report-header {
  background: #f7f8fb;
}

.sales-report-header > span {
  color: #697386;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
}

.report-empty {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 28px 22px;
}

.report-empty > span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: #f1f4f9;
  color: #697386;
}

.report-empty strong {
  display: block;
  margin-bottom: 4px;
  color: #172033;
}

.report-empty p {
  color: #697386;
  font-size: 14px;
}
@media (max-width: 800px) {
  .sales-report-summary {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .sales-report {
    margin-top: 24px;
  }

  .report-section-heading h2 {
    font-size: 21px;
  }

  .sales-report-stat {
    min-height: 95px;
  }

  .sales-report-table-heading {
    padding: 18px;
  }

  .sales-report-row {
    padding: 14px 18px;
  }
}
/* ========================================
   REPORT PERIOD FILTER
======================================== */

.report-period-filter {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}

.report-period-filter label {
  color: #4f5b70;
  font-size: 14px;
  font-weight: 600;
}

.report-period-filter select {
  min-width: 190px;
  padding: 10px 14px;
  border: 1px solid #dce1ea;
  border-radius: 10px;
  background: #ffffff;
  color: #172033;
  outline: none;
  cursor: pointer;
}

.report-period-filter select:focus {
  border-color: #9aa8bf;
}
@media (max-width: 600px) {
  .report-period-filter {
    align-items: stretch;
    flex-direction: column;
  }

  .report-period-select {
    align-items: stretch;
    flex-direction: column;
  }

  .report-period-filter select {
    width: 100%;
  }

  .report-custom-dates {
    align-items: stretch;
    flex-direction: column;
  }

  .report-custom-dates input {
    width: 100%;
  }
}
/* ========================================
   CUSTOM REPORT DATES
======================================== */

.report-period-select {
  display: flex;
  align-items: center;
  gap: 10px;
}

.report-custom-dates {
  display: flex;
  align-items: flex-end;
  gap: 12px;
}

.report-custom-dates > div {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.report-custom-dates label {
  color: #697386;
  font-size: 12px;
  font-weight: 600;
}

.report-custom-dates input {
  padding: 10px 12px;
  border: 1px solid #dce1ea;
  border-radius: 10px;
  background: #ffffff;
  color: #172033;
  outline: none;
}

.report-custom-dates input:focus {
  border-color: #9aa8bf;
}
.inventory-report {
  margin-top: 32px;
}

.inventory-report-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.inventory-report-stat {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
}

.inventory-report-stat > span {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  background: #f1f5f9;
  border-radius: 14px;
  font-size: 22px;
}

.inventory-report-stat small {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 13px;
}

.inventory-report-stat strong {
  display: block;
  color: #172033;
  font-size: 21px;
}

.inventory-report-table-wrapper {
  overflow-x: auto;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
}

.inventory-report-table {
  min-width: 760px;
}

.inventory-report-row {
  display: grid;
  grid-template-columns: 1.5fr 1.2fr 1fr 0.8fr 1fr;
  gap: 16px;
  align-items: center;
  padding: 18px 28px;
  border-bottom: 1px solid #e2e8f0;
}

.inventory-report-row:last-child {
  border-bottom: none;
}

.inventory-report-header {
  background: #f8fafc;
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
}

.inventory-report-row > span {
  color: #475569;
  font-size: 14px;
}

.inventory-report-row:not(.inventory-report-header) > span:first-child {
  color: #172033;
  font-weight: 600;
}

.inventory-report-empty {
  padding: 32px;
  color: #64748b;
  text-align: center;
}

.inventory-report-footer {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 16px;
  padding: 16px 20px;
  background: #f8fafc;
  border-radius: 12px;
  color: #64748b;
  font-size: 14px;
}

.inventory-report-footer strong {
  color: #172033;
}

@media (max-width: 1000px) {
  .inventory-report-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .inventory-report-summary {
    grid-template-columns: 1fr;
  }

  .inventory-report-footer {
    align-items: stretch;
    flex-direction: column;
  }
}
