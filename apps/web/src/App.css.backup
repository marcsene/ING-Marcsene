.customer-report-row {
  display: grid;
  grid-template-columns: 1.2fr 1.5fr 1fr 1.3fr 0.8fr;
  gap: 16px;
  align-items: center;
  padding: 18px 28px;
  border-bottom: 1px solid #e2e8f0;
}

.customer-report-row:last-child {
  border-bottom: none;
}

.customer-report-header {
  background: #f8fafc;
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
}

.customer-report-row > span {
  overflow: hidden;
  color: #475569;
  font-size: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-report-row:not(.customer-report-header) > span:first-child {
  color: #172033;
  font-weight: 600;
}

.customer-report-empty {
  padding: 32px;
  color: #64748b;
  text-align: center;
}

.customer-report-footer {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 16px;
  padding: 16px 20px;
  background: #f8fafc;
  border-radius: 12px;
  color: #64748b;
  font-size: 14px;
}

.customer-report-footer strong {
  color: #172033;
}

@media (max-width: 800px) {
  .customer-report-summary {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .customer-report-footer {
    align-items: stretch;
    flex-direction: column;
  }
}
.sidebar-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px 20px 18px;
}

.sidebar-brand-icon {
  display: block;
  width: 58px;
  height: 58px;
  object-fit: contain;
}